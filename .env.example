PORT=3000
NODE_ENV=development
# Required in production: private random value, at least 32 characters.
JWT_SECRET=
# Set absolute paths on the LAN server. Empty DATA_DIR defaults to ./runtime-data.
DATA_DIR=
LEGACY_DATA_FILE=
# Use a separate backup device in production.
BACKUP_DIR=
# Empty defaults to a separate configuration subfolder inside BACKUP_DIR.
CONFIGURATION_BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=240
BACKUP_RETENTION_DAYS=30
# Daily snapshot at midnight in this time zone.
BACKUP_TIMEZONE=Asia/Riyadh
# First administrator only, if no existing hash: 12+ characters.
BOOTSTRAP_ADMIN_PASSWORD=
# Exact comma-separated browser origins if using a reverse proxy.
ALLOWED_ORIGINS=
# Enable only when running behind your trusted reverse proxy.
TRUST_PROXY=0
GEMINI_API_KEY=

